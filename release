#!/bin/sh
set -eu

[ "$#" -eq 1 ] || { echo 'Usage: release X.Y.Z' >&2; exit 2; }
version=$1
case "$version" in ''|*[!0-9.]*) echo 'Version must be X.Y.Z' >&2; exit 2 ;; esac
printf '%s\n' "$version" | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
cd "$(dirname "$0")"
grep -Fq "public static let version = \"$version\"" Sources/CookedCore/UsageModels.swift
[ -z "$(git status --porcelain)" ] || { echo 'Working tree must be clean.' >&2; exit 1; }
commit=$(git rev-parse HEAD)
tag=$(git rev-parse -q --verify "refs/tags/v$version^{commit}" || true)
[ -z "$tag" ] || [ "$tag" = "$commit" ] || { echo 'Version tag points to another commit.' >&2; exit 1; }

mkdir -p dist
mkdir dist/.release-lock 2>/dev/null || { echo 'Another release is running (dist/.release-lock).' >&2; exit 1; }
trap 'rmdir dist/.release-lock' EXIT
temporary=$(mktemp -d)
trap 'rm -rf "$temporary"; rmdir dist/.release-lock' EXIT
trap 'exit 1' HUP INT TERM

swift test -Xswiftc -warnings-as-errors
swift build -c release --arch arm64 --arch x86_64 -Xswiftc -warnings-as-errors
bin=$(swift build -c release --arch arm64 --arch x86_64 --show-bin-path)/cooked
out=$temporary/$version
mkdir -p "$out"
cp "$bin" "$out/cooked"
strip -x "$out/cooked"
codesign --force --sign - "$out/cooked"
codesign --verify --strict "$out/cooked"
architectures=$(lipo -archs "$out/cooked")
for architecture in arm64 x86_64; do
    case " $architectures " in
        *" $architecture "*) ;;
        *) echo "Missing $architecture binary slice." >&2; exit 1 ;;
    esac
    xcrun vtool -arch "$architecture" -show-build "$out/cooked" > "$temporary/build-$architecture"
    awk '
        $1 == "platform" { if ($2 != "MACOS") exit 1; platform = 1 }
        $1 == "minos" {
            count++
            if ($2 !~ /^[0-9]+\.[0-9]+(\.[0-9]+)?$/) exit 1
            split($2, version, ".")
            if (version[1] > 13 || (version[1] == 13 && (version[2] > 0 || version[3] > 0))) exit 1
        }
        END { if (!platform || count != 1) exit 1 }
    ' "$temporary/build-$architecture" || { echo "The $architecture binary must support macOS 13.0." >&2; exit 1; }
done
[ "$("$out/cooked" --help)" = 'Usage: cooked' ]
[ "$("$out/cooked" --version)" = "$version" ]
hash=$(shasum -a 256 "$out/cooked"); hash=${hash%% *}
printf '{"version":"%s","url":"https://github.com/DJean/am-i-cooked/releases/download/v%s/cooked","sha256":"%s"}\n' \
    "$version" "$version" "$hash" > "$out/manifest.json"
cp install "$out/install"
chmod 755 "$out/install"
(cd "$out" && shasum -a 256 cooked install manifest.json > SHA256SUMS)
if [ -d "dist/$version" ]; then
    diff -qr "$out" "dist/$version" || { echo 'Immutable release differs; bump Build.version.' >&2; exit 1; }
else
    mv "$out" "dist/$version"
fi
printf 'Built universal release: dist/%s/\n' "$version"
